# ==============================================================================
# WEB (NEXT.JS) ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Gunakan konfigurasi ini di Vercel Environment Variables atau .env.local

# URL Endpoint Backend API (NestJS)
# Lokal: http://localhost:3000
# Produksi (Railway / Render / VPS): https://api-absensi.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL Socket.IO Gateway untuk Real-time Attendance Stream
# Lokal: http://localhost:3000
# Produksi: https://api-absensi.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
